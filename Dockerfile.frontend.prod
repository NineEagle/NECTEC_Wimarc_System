FROM node:20-slim AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

FROM node:20-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_SHOW_TOR_LABELS
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ARG NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
ARG BACKEND_PROXY_URL=http://backend:8000
ARG MEDIA_PROXY_URL=http://host.docker.internal
ENV NEXT_PUBLIC_SHOW_TOR_LABELS=$NEXT_PUBLIC_SHOW_TOR_LABELS
ENV NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ENV NEXT_PUBLIC_GOOGLE_MAP_ID=$NEXT_PUBLIC_GOOGLE_MAP_ID
ENV BACKEND_PROXY_URL=$BACKEND_PROXY_URL
ENV MEDIA_PROXY_URL=$MEDIA_PROXY_URL
RUN pnpm exec next build

FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# No corepack here on purpose: the runner invokes next directly, so it needs no
# package manager at runtime. Keeping `pnpm exec` would break under USER node —
# corepack cannot see the root-owned cache built above and tries to fetch the
# latest pnpm at container start, which fails on Node 20.
COPY --from=builder /app/package.json /app/pnpm-lock.yaml* ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.* ./
# Run unprivileged. node:20-slim ships a `node` user (uid 1000); only .next needs
# to be writable at runtime (next start writes .next/cache for image optimisation).
USER node
EXPOSE 3000
CMD ["node_modules/.bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
