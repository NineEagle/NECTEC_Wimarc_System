# ──────────────────────────────────────────────────────────────────────
# Production environment template for Frontend server (.200)
# Copy to .env.production on server, fill values, never commit real secrets
# ──────────────────────────────────────────────────────────────────────

# Public flags (baked into client bundle at build time)
NEXT_PUBLIC_SHOW_TOR_LABELS=1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth — production client (separate from dev)
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://wimarc.in.th/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate fresh secret for production
# Command: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://wimarc.in.th
